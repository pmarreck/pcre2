# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	CAPTURE_HISTORY.md = Capture-history API semantics, unsupported modes, implementation and open questions
	DFA_COMPATIBILITY.md = Public compatibility-query contract and validation evidence
	INTENT.md = Fork purpose and supported validation scope
	PLAN.md = Upstream refresh validation and downstream DFA integration tasks
	build = Optimized Nix package build entry point
	docs/PLAN_LOG.md = Archived fork implementation and validation history
	docs/capture_history/OVERLAP_SEMANTICS.md = Overlap family-semantics decision doc: rules, counterexamples, measurements, options
	docs/capture_history/UPSTREAM_FINDINGS.md = Upstream PCRE2 interpreter/JIT divergence found by the capture-history fuzzer, with minimal reproducers
	flake.lock = Exact Nix build dependency revisions
	flake.nix = Pinned static/shared CMake builds and upstream test checks
	fuzz = Deep interpreter-vs-JIT capture-history differential at all widths: ./fuzz [cases] [seed]
	src/zig/capture_history.zig = Zig module: CaptureEvent extern struct, width-suffixed Api.events borrowed slice, group iterator
	src/zig/capture_history_test.zig = Zig tests: C layout match, borrowed pointer identity, stale-history clearing, group iteration
	test = Full static and shared test entry point
	tests/benchmark/capture_history_bench.c = Fixed pcre2_match workload comparing cost with capture history off vs on (hyperfine input)
	tests/capture_history.c = C tests for committed capture-close history: rollback, assertions, recursion, lifecycle, allocator; all widths
	tests/capture_history_jit_diff.c = Seeded random-pattern differential: interpreter vs JIT rc, ovector and capture history
	tests/dfa_compatibility.c = C API classifier and DFA execution regressions for all code-unit widths
]
